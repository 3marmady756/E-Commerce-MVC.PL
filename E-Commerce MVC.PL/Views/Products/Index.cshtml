            color: #fff !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(233,69,96,0.15);
        }

        .page-link.active {
            box-shadow: 0 4px 12px rgba(233,69,96,0.2);
        }

        .page-link {
            font-weight: 500;
            font-size: 1.1rem;
        }

        .pagination {
            margin-bottom: 0;
