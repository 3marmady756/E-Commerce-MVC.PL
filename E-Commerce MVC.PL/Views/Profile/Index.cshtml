@{
    ViewData["Title"] = "MyAccount";
}

<section class="py-5">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 sidebar" style="background-color:#fff; padding:80px 0 0 60px; border-right:none;">
                <h6 class="sidebar-heading" style="font-size:1.2rem;font-weight:bold;margin-bottom:15px;">Manage My Account</h6>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">My Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Address Book</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">My Payment Options</a>
                    </li>
                </ul>
                <h6 class="sidebar-heading mt-4" style="font-size:1.2rem;font-weight:bold;margin-bottom:15px;">My Orders</h6>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="#">My Orders</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">My Returns</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">My Cancellations</a>
                    </li>
                </ul>
                <h6 class="sidebar-heading mt-4" style="font-size:1.2rem;font-weight:bold;margin-bottom:15px;">My Wishlist</h6>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="#">My Wishlist</a>
                    </li>
                </ul>
            </div>
            <!-- Form -->
            <div class="col-md-9">
                <div class="top-bar d-flex justify-content-end align-items-center py-3" style="font-size:1rem;">
                    <span class="welcome-text" style="color:#6c757d;">Welcome!</span>
                    <span class="user-name ms-2" style="color:#000;font-weight:bold;">Ahmed Tamer</span>
                </div>
                <div class="form-container bg-white p-4 rounded-3 shadow-sm">
                    <h5 class="mb-4" style="color:#dc3545;font-size:1.5rem;font-weight:bold;">Edit Your Profile</h5>
                    <form>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label for="firstName">First Name</label>
                                <input type="text" class="form-control" id="firstName" placeholder="First Name" value="Ahmed">
                            </div>
                            <div class="form-group col-md-6">
                                <label for="lastName">Last Name</label>
                                <input type="text" class="form-control" id="lastName" placeholder="Last Name" value="Tamer">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="Email" value="ahmedtamer@gmail.com">
                        </div>
                        <div class="form-group">
                            <label for="address">Address</label>
                            <input type="text" class="form-control" id="address" placeholder="Address" value="Kingston, 5236, United State">
                        </div>
                        <hr>
                        <h6 class="mb-3">Password Changes</h6>
                        <div class="form-group">
                            <input type="password" class="form-control" id="currentPassword" placeholder="Current Password">
                        </div>
                        <div class="form-group">
                            <input type="password" class="form-control" id="newPassword" placeholder="New Password">
                        </div>
                        <div class="form-group">
                            <input type="password" class="form-control" id="confirmNewPassword" placeholder="Confirm New Password">
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-link">Cancel</button>
                            <button type="submit" class="btn btn-danger">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        body {
            background-color: #fff;
        }
        .sidebar {
            background-color: #fff;
            padding: 80px 0 0 60px !important;
            border-right: none;
        }
        .sidebar-heading {
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 15px;
        }
        .nav-item a {
            color: #343a40;
            padding: 8px 0 0 25px;
            display: block;
            text-decoration: none;
        }
        .nav-item a:hover {
            color: #007bff;
        }
        .form-container {
            background-color: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .form-container h5 {
            color: #dc3545;
            font-size: 1.5rem;
            margin-bottom: 20px;
            font-weight: bold;
        }
        .form-group label {
            font-size: 0.9rem;
            color: #495057;
            font-weight: bold;
        }
        .form-control {
            background-color: #F5F5F5;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
            padding: 0.375rem 0.75rem;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }
        .form-control::placeholder {
            color: #6c757d;
        }
        .btn-danger {
            background-color: #dc3545;
            border-color: #dc3545;
            color: #fff;
        }
        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }
        .btn-link {
            color: #343a40;
            text-decoration: none;
        }
        .btn-link:hover {
            color: #007bff;
            text-decoration: underline;
        }
        .top-bar .welcome-text {
            color: #6c757d;
        }
        .top-bar .user-name {
            color: #000;
            font-weight: bold;
        }
    </style>
} 